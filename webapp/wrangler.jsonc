{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mrsdani-webapp",
	"account_id": "c62d915807e7e95e9fca7734d77f9859",
	"compatibility_date": "2026-09-14",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// /game-content/* nunca é servido direto pela Cloudflare — toda
		// requisição ali passa pelo nosso Worker primeiro (rota em
		// src/app/game-content/[slug]/route.ts), que confere login +
		// compra válida antes de buscar o arquivo real no binding ASSETS.
		"run_worker_first": ["/game-content/*", "/_jogo_arquivos/*"],
		// Desliga a resolução automática de "/foo" -> "/foo/index.html":
		// sem isso, a Cloudflare tratava /game-content/<slug> (nossa rota
		// protegida) como se fosse o mesmo arquivo estático de
		// /game-content/<slug>/index.html e servia ele direto, sem passar
		// pela nossa checagem de login/compra.
		"html_handling": "none"
	},
	"services": [
		{
			// Self-reference service binding, required by the OpenNext adapter.
			// The service name must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mrsdani-webapp"
		}
	]
}
